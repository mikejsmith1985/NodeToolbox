#!/usr/bin/env bash
# Forge Workflow Pre-Commit Hook (Enhanced)
# Generated by Forge Terminal Workflow Architect
# Enforces: main branch block, test file gate, CHANGELOG, naming, branch naming.
# Bypass with: git commit --no-verify (bypasses are logged)

# forge-hook-v1 — Forge Terminal runtime workflow gate (ledger + naming).
# Refuses a commit whose gates were never recorded. Falls through on success.
if [ "${FORGE_BYPASS:-0}" = "1" ]; then
  forge_ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  forge_reason="${FORGE_BYPASS_REASON:-no reason provided}"
  mkdir -p .forge
  printf "%s bypass: %s\n" "$forge_ts" "$forge_reason" >> .forge/bypasses.log
  echo "[forge] FORGE_BYPASS=1 — workflow gate skipped, logged to .forge/bypasses.log"
else
  forge_branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
  case "$forge_branch" in
    main|master)
      echo "[forge] BLOCKED: refusing to commit directly to '$forge_branch'." >&2
      echo "[forge] Create a feature branch first (e.g. 'git checkout -b feature/foo')." >&2
      echo "[forge] Set FORGE_BYPASS=1 with FORGE_BYPASS_REASON=... to override." >&2
      exit 1
      ;;
  esac

  # The running Forge exports its own path as FORGE_BIN. A bare "forge" on
  # PATH is deliberately NOT tried: an unrelated npm package answers to that
  # name, and the gate then blocked every commit with a message about nothing.
  forge_bin=""
  if [ -n "${FORGE_BIN:-}" ] && [ -x "$FORGE_BIN" ]; then forge_bin="$FORGE_BIN"
  elif [ -x "./forge" ]; then forge_bin="./forge"
  elif [ -x "./fterm.exe" ]; then forge_bin="./fterm.exe"
  elif [ -x "./forge.exe" ]; then forge_bin="./forge.exe"
  elif command -v fterm >/dev/null 2>&1; then forge_bin="fterm"
  fi

  if [ -z "$forge_bin" ]; then
    echo "[forge] WARNING: Forge Terminal not found — the workflow gate did NOT run." >&2
    echo "[forge] Commit from a Forge Terminal tab (FORGE_BIN is set there), or put fterm on PATH." >&2
  else
    # Names first: a name that reads badly is cheaper to fix before the
    # gates are argued about than after.
    "$forge_bin" workflow naming
    forge_naming_status=$?
    if [ "$forge_naming_status" -eq 2 ]; then
      echo "" >&2
      echo "[forge] BLOCKED: a name above tells the reader nothing." >&2
      echo "[forge] Rename it after what a person would see on screen, then retry." >&2
      echo "[forge] Override with FORGE_BYPASS=1 FORGE_BYPASS_REASON=... git commit ..." >&2
      exit 1
    fi

    "$forge_bin" workflow preflight
    forge_status=$?
    if [ "$forge_status" -eq 0 ]; then
      echo "[forge] workflow gate: PASS"
    elif [ "$forge_status" -eq 2 ]; then
      echo "" >&2
      echo "[forge] BLOCKED: workflow ticket is missing required gates, or belongs to another branch (see reason above)." >&2
      echo "[forge] Record this branch's gates via the workflow_gate_record MCP tool under a new taskId, then retry." >&2
      echo "[forge] Required gates: branch-created, tests-written, tests-passed, brief-published." >&2
      echo "[forge] Publish a brief with the change_brief_publish tool; record the rest with workflow_gate_record." >&2
      echo "[forge] Override with FORGE_BYPASS=1 FORGE_BYPASS_REASON=... git commit ..." >&2
      exit 1
    else
      echo "[forge] preflight returned unexpected status $forge_status — blocking commit." >&2
      echo "[forge] '$forge_bin' did not answer like Forge Terminal; commit from a Forge tab so FORGE_BIN is set." >&2
      exit 1
    fi
  fi
fi

set +e
violations=()
warnings=()

# ── MAIN BRANCH BLOCK (Gate 2) ──────────────────────────────────────────
# Commits directly to main are forbidden. All work must happen on feature branches.
current_branch=$(git branch --show-current 2>/dev/null)
if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
    violations+=("MAIN BRANCH: Cannot commit directly to main — create a feature branch first")
fi

# Branch Naming Check
if [[ -n "$current_branch" ]] && ! echo "$current_branch" | grep -qE "^(main|master|develop|feature/.+|fix/.+|chore/.+|docs/.+|hotfix/.+|release/.+)$"; then
    violations+=("BRANCH: '$current_branch' does not match naming convention")
fi

# Get Staged Files
staged_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[[ -z "$staged_files" ]] && exit 0

# Files that are tests rather than authored product code. Used to keep the CHANGELOG gate off
# test-only commits: a test proves behaviour, it does not change it, so there is nothing for a user
# to read about in the CHANGELOG. The test-file gate below already skips these same files.
test_file_pattern='(_test\.go|\.test\.(js|jsx|ts|tsx)|\.spec\.(js|jsx|ts|tsx)|_test\.py|_test\.rs)$'

# Filter to source files
source_files=$(echo "$staged_files" | grep -E '\.(go|js|jsx|ts|tsx|py|rs|java|cs)$')

# Product source only — tests excluded. This is what the CHANGELOG gate reads.
product_source_files=$(echo "$source_files" | grep -vE "$test_file_pattern")

# ── TEST FILE GATE (Gate 4) ─────────────────────────────────────────────
# Every new source file must have a corresponding test file staged or on disk.
# Build output directories are excluded — they contain compiled artifacts, not
# authored source code, and must never be flagged for missing test coverage.
new_source_files=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep -E '\.(go|js|jsx|ts|tsx|py|rs|java|cs)$' | grep -vE '^(cmd/forge/web/|frontend/dist/|bin/)')
if [[ -n "$new_source_files" ]]; then
    while IFS= read -r new_file; do
        # Skip files that are themselves test files
        if echo "$new_file" | grep -qE '(_test\.go|\.test\.(js|jsx|ts|tsx)|\.spec\.(js|jsx|ts|tsx)|_test\.py|_test\.rs)$'; then
            continue
        fi
        extension="${new_file##*.}"
        base_name="${new_file%.*}"
        has_test=false
        if [[ "$extension" == "go" ]]; then
            expected_test="${base_name}_test.go"
            if echo "$staged_files" | grep -qF "$expected_test" || [[ -f "$expected_test" ]]; then
                has_test=true
            fi
        else
            # JS/TS: check for .test and .spec variants — both colocated and in test/ hierarchy
            basename_only=$(basename "${new_file%.*}")
            for test_suffix in ".test.${extension}" ".spec.${extension}"; do
                expected_test="${base_name}${test_suffix}"
                if echo "$staged_files" | grep -qF "$expected_test" || [[ -f "$expected_test" ]]; then
                    has_test=true
                    break
                fi
                # Also search the test/ directory tree (supports test/unit/ and test/integration/ layouts)
                if find "test" -name "${basename_only}${test_suffix}" 2>/dev/null | grep -q .; then
                    has_test=true
                    break
                fi
            done
        fi
        if [[ "$has_test" == "false" ]]; then
            violations+=("TEST FILE: New source file '$new_file' has no corresponding test file")
        fi
    done <<< "$new_source_files"
fi

# ── CHANGELOG CHECK (Gate 7 — upgraded to violation) ────────────────────
# Product source changed but CHANGELOG.md not updated = blocking violation.
# Test-only commits are exempt: they change no behaviour, so there is nothing to document, and
# demanding an entry would only invite a fabricated one.
has_source_changes=false
[[ -n "$product_source_files" ]] && has_source_changes=true
changelog_updated=$(echo "$staged_files" | grep -c "CHANGELOG\.md$")
if $has_source_changes && [[ "$changelog_updated" -eq 0 ]]; then
    violations+=("CHANGELOG: Source files changed but CHANGELOG.md was not updated")
fi

# Report Results
if [[ ${#violations[@]} -gt 0 ]]; then
    echo -e "\n\033[31mPRE-COMMIT VIOLATIONS (blocking):\033[0m"
    for v in "${violations[@]}"; do echo -e "  \033[31m* $v\033[0m"; done
fi
if [[ ${#warnings[@]} -gt 0 ]]; then
    echo -e "\n\033[33mPRE-COMMIT WARNINGS (non-blocking):\033[0m"
    for w in "${warnings[@]}"; do echo -e "  \033[33m* $w\033[0m"; done
fi
if [[ ${#violations[@]} -eq 0 ]] && [[ ${#warnings[@]} -eq 0 ]]; then
    echo -e "\033[32mPre-commit checks passed\033[0m"
fi

if [[ ${#violations[@]} -gt 0 ]]; then
    echo -e "\033[31mCommit blocked. Fix violations or use --no-verify to bypass.\033[0m"
    exit 1
fi
exit 0
