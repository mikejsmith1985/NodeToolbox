{
  "compilerOptions": {
    /* Required by `tsc -b`. Without it the build cannot trust its own .tsbuildinfo, so every run
       rechecks the whole project from scratch: a no-op typecheck cost ninety seconds and made the
       release pipeline four times longer than the work it was doing. */
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Path aliases — must match vite.config.ts resolve.alias.
     * With moduleResolution "bundler", paths are relative to the tsconfig location.
     * No baseUrl needed — Vite resolves the alias at build/dev time; TS uses it for type-checking only. */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
